# ============= Application =============
PORT=3005

# ============= MongoDB =============
# --------------------- Connection ------------------
# Replace the placeholders with your MongoDB Atlas or local MongoDB connection string.
MONGODB_URI="mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority"

# --------------------- Optional Credentials ------------------
# Keep these only if your code or deployment tooling needs separate credential values.
MONGODB_USERNAME="<username>"
MONGODB_PASSWORD="<password>"
